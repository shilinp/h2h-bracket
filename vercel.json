{
  "version": 2,
  "cleanUrls": true,
  "outputDirectory": "web/dist",
  "rewrites": [
    { 
      "source": "/api/:path*", 
      "destination": "/api/index" 
    },
    { 
      "source": "/special", 
      "destination": "/special.html" 
    },
    { 
      "source": "/upload", 
      "destination": "/upload.html" 
    },
    { 
      "source": "/(.*)", 
      "destination": "/index.html" 
    }
  ]
}